+    /// Caret x for every character boundary, ascending by byte index.
+    /// RTL runs read right to left: a glyph's left edge is the caret *after*
+    /// its character, and the run's first character starts at its right edge.
+    fn caret_stops(&self) -> Vec<CaretStop> {
+        // Run starts; each run ends where the next begins (runs tile [0, len)).
+        let run_starts: Vec<usize> = self
+            .runs
+            .iter()
+            .map(|r| r.glyphs.iter().map(|g| g.index).min().unwrap_or(0))
+            .collect();
