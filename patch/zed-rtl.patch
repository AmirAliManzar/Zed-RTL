 impl LineLayout {
+    /// Enumerates every character boundary in the line together with the x
+    /// coordinate where the caret should be drawn for it, sorted ascending by
+    /// byte index.
+    ///
+    /// Runs are stored in *visual* order and are contiguous. Each run covers a
+    /// contiguous *logical* span `[start, end)`. For LTR runs a glyph's left
+    /// edge is the caret position *before* its character; for RTL runs it is
+    /// the caret position *after* its character (in visual order the previous
+    /// logical character sits to the glyph's right), and the caret *before* the
+    /// run's first character sits at the run's right edge.
+    fn caret_stops(&self) -> Vec<CaretStop> {
+        // The logical start of every run; used to derive each run's logical
+        // end without needing the source text (runs tile `[0, len)`).
+        let run_starts: Vec<usize> = self
+            .runs
+            .iter()
+            .map(|r| r.glyphs.iter().map(|g| g.index).min().unwrap_or(0))
+            .collect();
+
+        let mut stops: Vec<CaretStop> = Vec::new();
+        for (run_ix, run) in self.runs.iter().enumerate() {
+            if run.glyphs.is_empty() {
+                continue;
+            }
+            let min_ix = run_starts[run_ix];
+            let max_ix = run.glyphs.iter().map(|g| g.index).max().unwrap_or(0);
+            let run_end = run_starts
+                .iter()
+                .copied()
+                .filter(|start| *start > max_ix)
+                .min()
+                .unwrap_or(self.len);
+            // Visual right edge of this run = left edge of the next run in
+            // visual (array) order, else the full line width.
+            let run_right_x = self
+                .runs
+                .get(run_ix + 1)
+                .and_then(|next| next.glyphs.iter().map(|g| g.position.x).min())
+                .unwrap_or(self.width);
+            // Visual left edge of this run.
+            let run_left_x = run
+                .glyphs
+                .iter()
+                .map(|g| g.position.x)
+                .min()
+                .unwrap_or(px(0.));
+
+            // Group glyphs into *clusters*: glyphs that share a source index
+            // (a base character with its combining marks, or a ligature) are
+            // one cluster. A cluster is a single caret cell: the caret never
+            // stops between its glyphs. Clusters are contiguous in the stored
+            // (visual) order, and their left edge is the smallest glyph x.
+            let mut clusters: Vec<CaretStop> = Vec::new();
+            for glyph in &run.glyphs {
+                if let Some(last) = clusters.last_mut() {
+                    if last.index == glyph.index {
+                        if glyph.position.x < last.x {
+                            last.x = glyph.position.x;
+                        }
+                        continue;
+                    }
+                }
+                clusters.push(CaretStop {
+                    index: glyph.index,
+                    x: glyph.position.x,
+                    is_rtl: run.is_rtl,
+                });
+            }
+            // Clusters in ascending source-index order.
+            clusters.sort_by_key(|cluster| cluster.index);
+
+            if run.is_rtl {
+                // The caret before the run's first character: when the run
+                // starts the line this is the run's right edge (RTL reading
+                // begins on the right); when another run precedes it, it is
+                // the boundary with that run, at this run's left edge.
+                let before_x = if run_ix > 0 { run_left_x } else { run_right_x };
+                stops.push(CaretStop {
+                    index: min_ix,
+                    x: before_x,
+                    is_rtl: true,
+                });
+                for k in 0..clusters.len() {
+                    // The caret just *after* this character sits at this
+                    // cluster's left edge (the next logical character is
+                    // visually to its left); its byte index is the start of
+                    // the next logical character (or the run's end for the
+                    // last).
+                    let after = if k + 1 < clusters.len() {
+                        clusters[k + 1].index
+                    } else {
+                        run_end
+                    };
+                    // For the run's last character the caret is at the run's
+                    // right edge — the boundary with the following run — when
+                    // one follows, and at the run's left edge otherwise (RTL
+                    // text ends on the left).
+                    let after_x = if k + 1 < clusters.len() {
+                        clusters[k].x
+                    } else if run_ix + 1 < self.runs.len() {
+                        run_right_x
+                    } else {
+                        clusters[k].x
+                    };
+                    stops.push(CaretStop {
+                        index: after,
+                        x: after_x,
+                        is_rtl: true,
+                    });
+                }
+            } else {
+                for cluster in &clusters {
+                    stops.push(CaretStop {
+                        index: cluster.index,
+                        x: cluster.x,
+                        is_rtl: false,
+                    });
+                }
+                // Caret after the run's last character is at the run's right
+                // edge.
+                stops.push(CaretStop {
+                    index: run_end,
+                    x: run_right_x,
+                    is_rtl: false,
+                });
+            }
+        }
+        stops.sort_by_key(|stop| (stop.index, stop.is_rtl));
+        stops
+    }
