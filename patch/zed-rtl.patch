+/// A caret stop: the visual x coordinate at which the caret is drawn for a
+/// given character boundary (utf-8 byte index into the line's text).
+#[derive(Clone, Copy)]
+struct CaretStop {
+    index: usize,
+    x: Pixels,
+    is_rtl: bool,
+}
