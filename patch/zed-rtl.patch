+                        clusters[k].x
+                    } else if run_ix + 1 < self.runs.len() {
+                        run_right_x
+                    } else {
+                        clusters[k].x
+                    };
+                    stops.push(CaretStop {
+                        index: after,
+                        x: after_x,
+                        is_rtl: true,
+                    });
+                }
+            } else {
+                for cluster in &clusters {
+                    stops.push(CaretStop {
+                        index: cluster.index,
+                        x: cluster.x,
+                        is_rtl: false,
+                    });
+                }
+                // Caret after the run's last character.
+                stops.push(CaretStop {
+                    index: run_end,
+                    x: run_right_x,
+                    is_rtl: false,
+                });
+            }
+        }
+        stops.sort_by_key(|stop| (stop.index, stop.is_rtl));
+        stops
