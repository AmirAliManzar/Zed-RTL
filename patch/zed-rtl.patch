+    #[test]
+    fn test_caret_rtl_combining_mark() {
+        // "سَلام" where the ا (index 4) carries a combining mark: base glyph
+        // at x=10 and the mark at x=12 share source index 4, forming one
+        // cluster. The caret must never stop between them (there is no caret
+        // stop at x=12). Glyphs stored in visual (descending index) order.
+        let layout = make_layout_runs(
+            vec![make_rtl_run(
+                0,
+                vec![
+                    glyph_at(0., 6),  // م
+                    glyph_at(10., 4), // ا (base)
+                    glyph_at(12., 4), // َ combining mark, same cluster
+                    glyph_at(30., 2), // ل
+                    glyph_at(40., 0), // س
+                ],
+            )],
+            50.,
+            8,
+        );
+        assert_eq!(f32::from(layout.x_for_index(0)), 50.);
+        assert_eq!(f32::from(layout.x_for_index(2)), 40.);
+        assert_eq!(f32::from(layout.x_for_index(4)), 30.);
+        assert_eq!(f32::from(layout.x_for_index(6)), 10.);
+        assert_eq!(f32::from(layout.x_for_index(8)), 0.);
+        // Clicking inside the base+mark cluster resolves to the boundary on
+        // the cluster's left edge, never to a position between the glyphs.
+        assert_eq!(layout.index_for_x(px(11.)), Some(6));
+        assert_eq!(layout.index_for_x(px(15.)), Some(6));
+        assert_eq!(layout.closest_index_for_x(px(11.)), 6);
+    }
